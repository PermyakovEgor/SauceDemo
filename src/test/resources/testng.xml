<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo" parallel="tests">
    <test name="Smoke Tests">
        <parameter name="retryAnalyzer" value="RetryAnalyzer"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="pages.*"/>
            <package name="tests.*"/>
        </packages>
    </test>
</suite>